        for s in "${sp[@]}"; do
            printf "\r${CYAN}[${s}] ${BOLD}GGM NEURAL CORE PROCESSING${NC} "
            sleep $delay
        done
    done
    printf "\r${GREEN}[✓] CORE PURGE COMPLETE${NC}                  \n"
}

